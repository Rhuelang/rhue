--!strict
-- Milestone 3: functions, closures, varargs and the standard library.
-- Run with `rhue examples/closures.rhue` (add `--dump` to see every function's bytecode).

-- A counter factory: each counter has its own private `count`.
local function make_counter(step)
    local count = 0
    return function()
        count += step
        return count
    end
end

local by_one, by_ten = make_counter(1), make_counter(10)
by_one()
by_one()
by_ten()
print("counters:", by_one(), by_ten())

-- Memoised Fibonacci, with the cache "table" faked by a closure chain
-- (real tables arrive in milestone 4).
local function memo(f)
    local last_n, last_v = nil, nil
    return function(n)
        if n ~= last_n then
            last_n, last_v = n, f(n)
        end
        return last_v
    end
end

local function fib(n)
    if n < 2 then return n end
    local a, b = 0, 1
    for _ = 2, n do
        a, b = b, a + b
    end
    return b
end

local cached_fib = memo(fib)
print("fib(50) =", cached_fib(50))

-- Varargs: a tiny string formatter.
local function join(sep, ...)
    local out = ""
    for i = 1, select("#", ...) do
        if i > 1 then out ..= sep end
        out ..= tostring((select(i, ...)))
    end
    return out
end

print(join(" | ", "a", 1, true, nil, 2.5))

-- Each loop iteration captures its own `i`.
local first, last
for i = 1, 3 do
    local f = function() return i * i end
    if i == 1 then first = f end
    last = f
end
-- They're only set inside the loop, so the checker knows they could be
-- nil (if it never ran) until we say otherwise.
assert(first and last)
print("squares:", first(), last())

-- Errors carry a traceback through every frame.
local ok_value = tonumber("0x2A")
assert(ok_value == 42, "tonumber failed")
return ok_value

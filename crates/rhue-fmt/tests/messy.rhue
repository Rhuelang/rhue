local   Vec={}
Vec.__index=Vec


function Vec.new(x:number,y:number)  -- constructor
return setmetatable({x=x,y=y},Vec)
end
function Vec:len():number
    return math.sqrt(self.x*self.x+self.y*self.y)
  end
local function map<T,U>(xs:{T},f:(T)->U):{U}
local out={}
for i,v in xs do out[i]=f(v) end
return out
end

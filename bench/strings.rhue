-- expect: 988894 888895 686682
-- Concatenation, interning, string library calls.
local parts = {}
for i = 1, 100000 do
	parts[#parts + 1] = "item" .. i
end
local joined = table.concat(parts, ",")
local count = 0
for i = 1, 100000 do
	local s = parts[i]
	if string.sub(s, 1, 4) == "item" then
		count += #s
	end
end
local up = 0
for i = 1, 30000 do
	up += #string.upper(parts[i]) + #string.format("%d:%s", i, parts[i])
end
return #joined, count, up

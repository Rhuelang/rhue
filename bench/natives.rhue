-- expect: 2666667333343 1 100002
-- Calls into native functions, and natives calling back into script.
local s = 0
for i = 1, 2000000 do
	s += math.floor(i / 3) + math.max(i, 5)
end
local t = {}
for i = 1, 100000 do
	t[i] = (i * 7919) % 100003
end
table.sort(t, function(a, b) return a < b end)
return s, t[1], t[#t]
